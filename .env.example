# Copy to .env.local and fill in. Nothing here is required for local development.

# --- Public site details (exposed to the browser) ---
# Production origin, no trailing slash. Enables canonical URLs, sitemap and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=
# Shown in the contact section and footer only when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SERVICE_AREA=
# Optional self-serve scheduler (Calendly, Cal.com, …) offered alongside the request form.
NEXT_PUBLIC_SCHEDULING_URL=
# Optional private client gallery service (Pixieset, ShootProof, Pic-Time, …). Adds a "Client galleries" footer link.
NEXT_PUBLIC_CLIENT_GALLERY_URL=

# --- Consultation request delivery (server only — never prefix with NEXT_PUBLIC_) ---
# Required in production. Without them the form shows an error instead of claiming success.
# In development, requests are written to .data/consultation-requests.jsonl instead.
RESEND_API_KEY=
# Comma-separated recipients.
CONSULTATION_TO_EMAIL=
# Must be an address on a domain verified with Resend, e.g. "Studio <bookings@yourdomain.com>".
CONSULTATION_FROM_EMAIL=
